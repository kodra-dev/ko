opset -p on $_obj_geo1_configurecontrols3

opcf $arg1
opcf $arg1
opwire -n $_obj_geo1_null5 -0 $_obj_geo1_controlextract3
opcf $arg1
opwire -n -o 1 $_obj_geo1_controlextract3 -0 $_obj_geo1_attachjointgeo4
opwire -n $_obj_geo1_control_shape_library3 -1 $_obj_geo1_attachjointgeo4
opcf $arg1
opwire -n $_obj_geo1_null5 -0 $_obj_geo1_packfolder5
