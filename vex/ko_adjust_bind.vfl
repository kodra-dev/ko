// Replay the authored surface samples. Store one bounded, combined field for the stroke.
int resolve(int g; string mode, authored_part, part_filter; vector center, n; float reach;
            export vector q, resolved_normal; export string issue) {
    float eps=max(reach*1e-5,1e-8);
    vector hits[], uv[];
    int prims[];
    int count=intersect_all(g,"",center+(reach+2*eps)*n,-(2*reach+4*eps)*n,hits,prims,uv,eps,-1);
    if (count>64) { issue="Too many anchor candidates"; return -1; }
    if (count<=0) { issue="Anchor could not find its surface; rebind"; return -1; }
    float scores[];
    resize(scores,count);
    float best=1e20;
    int best_index=-1;
    for (int i=0; i<count; i++) {
        scores[i]=1e20;
        string part=prim(g,"__ko_adjust_part",prims[i]);
        float offset=abs(dot(hits[i]-center,n));
        float facing=dot(prim_normal(g,prims[i],uv[i]),n);
        if ((part_filter!="" && part!=part_filter) || offset>reach+eps || facing<.6) continue;
        scores[i]=offset+(1-facing)*reach*.15;
        if (scores[i]<best) { best=scores[i]; best_index=i; }
    }
    if (best_index<0) { issue="Anchor could not find its surface; rebind"; return -1; }
    int seed=prims[best_index];
    q=hits[best_index];
    resolved_normal=normalize(prim_normal(g,seed,uv[best_index]));
    string chosen=prim(g,"__ko_adjust_part",seed);
    int seed_points[]=primpoints(g,seed);
    for (int i=0; i<count; i++) {
        if (i==best_index || scores[i]>best+max(eps*8,reach*.025)) continue;
        int coincident=distance(q,hits[i])<=eps*8;
        if (mode=="nearby" && coincident) continue;
        int shared=0;
        foreach (int p;primpoints(g,prims[i])) shared |= find(seed_points,p)>=0;
        string part=prim(g,"__ko_adjust_part",prims[i]);
        if (coincident && shared) {
            if (mode=="part" && chosen!=part && part==authored_part) {
                seed=prims[i]; chosen=part;
                resolved_normal=normalize(prim_normal(g,seed,uv[i]));
            }
            continue;
        }
        issue="Two equally plausible surfaces; use a named part, Nearby in 3D, or rebind";
        return -1;
    }
    return seed;
}

dict stamp_distances(int g, seed; string mode, chosen; vector q; float radius;
                     export int budget; export string issue) {
    dict distances, queued;
    if (mode=="nearby") {
        int points[]=nearpoints(g,q,radius,25001);
        budget-=len(points);
        if (len(points)>25000 || budget<0) { issue="Brush exceeded the local traversal budget"; return distances; }
        foreach (int p; points) distances[itoa(p)]=distance(point(g,"P",p),q);
        return distances;
    }
    int queue[];
    foreach (int p;primpoints(g,seed)) {
        float d=distance(point(g,"P",p),q);
        if (d>=radius) continue;
        string key=itoa(p);
        distances[key]=d; queued[key]=1;
        append(queue,p);
    }
    for (int k=0; k<len(queue); k++) {
        if (--budget<0) { issue="Brush exceeded the local traversal budget"; break; }
        int p=queue[k];
        string key=itoa(p);
        float d=distances[key];
        queued[key]=0;
        vector pos=point(g,"P",p);
        foreach (int f;pointprims(g,p)) {
            if (mode=="part" && string(prim(g,"__ko_adjust_part",f))!=chosen) continue;
            int ring[]=primpoints(g,f);
            int i=find(ring,p);
            int near[]=array(ring[(i+1)%len(ring)],ring[(i+len(ring)-1)%len(ring)]);
            foreach (int nb;near) {
                float nextd=d+distance(pos,point(g,"P",nb));
                string id=itoa(nb);
                if (nextd>=radius || (isvalidindex(distances,id) && nextd>=float(distances[id]))) continue;
                distances[id]=nextd;
                if (!int(queued[id])) { queued[id]=1; append(queue,nb); }
            }
        }
    }
    return distances;
}

string mode=chs("mode"), anchor_part=chs("anchor_part"), authored=chs("definition");
string current=detail(0,"__ko_adjust_part_key"), part_error=detail(0,"__ko_adjust_part_error");
string weight=chs("weight"), status=chs("status");
vector centers[]=array(chv("center")), normals[]=array(normalize(chv("normal")));
float radius=chf("radius"), reach=chf("reach"), falloff=clamp(chf("falloff"),.2,5.);
string samples=chs("samples");
if (samples!="") {
    dict payload=json_loads(samples,2);
    float data[]=payload["samples"];
    for (int i=0; i+5<len(data) && len(centers)<96; i+=6) {
        append(centers,set(data[i],data[i+1],data[i+2]));
        append(normals,normalize(set(data[i+3],data[i+4],data[i+5])));
    }
}
string issue="", first_part="";
vector resolved_centers[], resolved_normals[];
dict combined, dominant, index, touched;
if (radius<=0 || reach<=0 || length2(normals[0])<.5) issue="Invalid radius or anchor frame";
else if (part_error!="") issue=part_error;
else if (authored!="" && current!=authored) issue="Part definition changed; rebind this edit";
int budget=240000;
for (int s=0; s<len(centers) && issue==""; s++) {
    string filter=(s>0 && mode=="part") ? first_part :
        (startswith(current,"attribute:") && authored!="" ? anchor_part : "");
    if (s>0 && mode!="part") filter="";
    vector q, n;
    int seed=resolve(0,mode,anchor_part,filter,centers[s],normals[s],reach,q,n,issue);
    if (seed<0) break;
    string chosen=prim(0,"__ko_adjust_part",seed);
    if (!s) first_part=chosen;
    if (s>0 && mode=="part" && chosen!=first_part) { issue="Stroke crossed its selected part"; break; }
    dict distances=stamp_distances(0,seed,mode,chosen,q,radius,budget,issue);
    if (issue!="") break;
    append(resolved_centers,q); append(resolved_normals,n);
    int written=0, overlaps=0;
    foreach (string id;keys(distances)) {
        int p=atoi(id), border=0;
        int faces[]=pointprims(0,p);
        if (mode=="part") foreach (int f;faces)
            if (string(prim(0,"__ko_adjust_part",f))!=chosen) { border=1; break; }
        if (border) continue;
        float t=clamp(1-float(distances[id])/radius,0,1);
        if (t<=0.) continue;
        float w=pow(t*t*(3-2*t),falloff);
        float old=combined[id];
        if (old>0) overlaps++;
        combined[id]=1-(1-old)*(1-w);
        if (w>float(dominant[id])) { dominant[id]=w; index[id]=s; }
        foreach (int f;faces) { string part=prim(0,"__ko_adjust_part",f); touched[part]=1; }
        written++;
    }
    if (!written) issue="Brush is smaller than local spacing or lies on pinned boundaries";
    else if (s>0 && mode!="nearby" && !overlaps) issue="Stroke lost its connected footprint; rebind";
}
if (issue=="") {
    addpointattrib(0,weight,0.0);
    if (len(centers)>1) addpointattrib(0,weight+"_stamp",0);
    foreach (string id;keys(combined)) {
        int p=atoi(id);
        setpointattrib(0,weight,p,float(combined[id]),"set");
        if (len(centers)>1) setpointattrib(0,weight+"_stamp",p,int(index[id]),"set");
    }
    setdetailattrib(0,weight+"_center",resolved_centers[0],"set");
    setdetailattrib(0,weight+"_normal",resolved_normals[0],"set");
    setdetailattrib(0,weight+"_centers",resolved_centers,"set");
    setdetailattrib(0,weight+"_normals",resolved_normals,"set");
    setdetailattrib(0,weight+"_parts",keys(touched),"set");
    setdetailattrib(0,weight+"_part",first_part,"set");
}
setdetailattrib(0,status,issue,"set");
if (issue!="") warning("KoAdjust brush: %s",issue);
