<?xml version="1.0" encoding="UTF-8"?>
<mainMenu>
  <menuBar>
    <subMenu id="ko_menu">
      <label>Ko</label>
      <insertBefore>help_menu</insertBefore>
      <scriptItem id="h.ko_toggle_parameters">
        <label>Toggle Parameters</label>
        <scriptCode><![CDATA[
import ko_parameters
ko_parameters.toggle_parameters()
]]></scriptCode>
      </scriptItem>
      <subMenu id="ko_zed_menu">
        <label>Zed</label>
        <scriptItem id="h.ko_zed_sync">
          <label>Sync Houdini → Zed</label>
          <scriptCode><![CDATA[
import ko_zed
ko_zed.sync_to_zed()
]]></scriptCode>
        </scriptItem>
        <scriptItem id="h.ko_zed_sessions">
          <label>Zed Sessions…</label>
          <scriptCode><![CDATA[
import ko_zed
ko_zed.sessions()
]]></scriptCode>
        </scriptItem>
        <scriptItem id="h.ko_zed_shortcuts">
          <label>Toggle Zed Shortcuts</label>
          <scriptCode><![CDATA[
import hou
import ko_zed_shortcuts
try:
    ko_zed_shortcuts.toggle()
except Exception as error:
    hou.ui.displayMessage(str(error), severity=hou.severityType.Error)
]]></scriptCode>
        </scriptItem>
      </subMenu>
    </subMenu>
    <subMenu id="loom_menu">
      <label>Loom</label>
      <insertBefore>help_menu</insertBefore>
      <scriptItem id="h.loom_open_agent">
        <label>Toggle Loom</label>
        <scriptCode><![CDATA[
import loom
loom.toggle_pane()
]]></scriptCode>
      </scriptItem>
      <scriptItem id="h.loom_open_checkpoints">
        <label>Toggle Checkpoints</label>
        <scriptCode><![CDATA[
from loom import checkpoints
checkpoints.toggle_pane()
]]></scriptCode>
      </scriptItem>
      <separatorItem id="loom_reload_separator"/>
      <scriptItem id="h.loom_reload_package">
        <label>Reload Loom + Checkpoints</label>
        <scriptCode><![CDATA[
import loom
loom.request_reload()
]]></scriptCode>
      </scriptItem>
    </subMenu>
  </menuBar>
</mainMenu>
