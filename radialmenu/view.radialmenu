				},
				"7":{
					"label":"Brush",
					"type":"script_action",
					"icon":"MTOOLS_select_mode_brushselect",
					"script":"radialmenu.setPickStyle(kwargs, hou.pickStyle.Brush)"
				}
			}
		}
	}
