					"type":"script_action",
					"icon":"VIEW_smooth",
					"check":"radialmenu.shadingMode(kwargs) == hou.glShadingType.Smooth",
					"script":"import ko_ui\n\nradialmenu.setShadingMode(kwargs, hou.glShadingType.Smooth)\n"
				},
				"5":{
					"label":"Flat Wire Shaded",
					"type":"script_action",
					"icon":"VIEW_flat_wireframe",
					"check":"radialmenu.shadingMode(kwargs) == hou.glShadingType.FlatWire",
					"script":"import ko_ui\n\nradialmenu.setShadingMode(kwargs, hou.glShadingType.FlatWire)\n"
				},
				"6":{
					"label":"Flat Shaded",
					"type":"script_action",
					"icon":"VIEW_flat",
					"check":"radialmenu.shadingMode(kwargs) == hou.glShadingType.Flat",
					"script":"import ko_ui\n\nradialmenu.setShadingMode(kwargs, hou.glShadingType.Flat)\n"
				},
				"7":{
					"label":"MatCap Shaded",
					"type":"script_action",
					"icon":"hicon:/SVGIcons.index?VIEW_matcap.svg",
					"check":"radialmenu.shadingMode(kwargs) == hou.glShadingType.MatCap",
					"script":"import ko_ui\n\nradialmenu.setShadingMode(kwargs, hou.glShadingType.MatCap)\n"
				}
			}
		},
		"6":{
			"label":"Selection Tools",
			"type":"submenu",
			"items":{
				"0":{
					"label":"Laser",
					"type":"script_action",
					"icon":"TOOLS_select_mode_laser",
					"check":"radialmenu.pickStyle(kwargs) == hou.pickStyle.Laser",
					"script":"radialmenu.setPickStyle(kwargs, hou.pickStyle.Laser)"
				},
				"4":{
					"label":"Lasso",
					"type":"script_action",
					"icon":"TOOLS_select_mode_lasso",
					"check":"radialmenu.pickStyle(kwargs) == hou.pickStyle.Lasso",
